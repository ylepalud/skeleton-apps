<?xml version="1.0" encoding="utf-8"?>
<!-- The session never leaves the device: its key lives in this device's keystore only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
